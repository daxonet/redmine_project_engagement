<div class="box tabular">
  <p>
    <label for="version_name"><%= l(:field_name) %></label><span class="required"> *</span>
    <%= f.text_field :name, size: 60, required: true %>
  </p>
  <p>
    <label for="version_description"><%= l(:field_description) %></label>
    <%= f.text_field :description, size: 60 %>
  </p>
  <p>
    <label for="version_version_type"><%= l(:field_version_type) %></label>
    <%= f.select :version_type, version_type_options, {}, { id: 'version_version_type', onchange: 'toggleSubType()' } %>
  </p>
  <p id="sub_type_field" style="<%= @version.version_type == 'Milestone' ? '' : 'display:none;' %>">
    <label for="version_version_sub_type"><%= l(:field_version_sub_type) %></label>
    <%= f.select :version_sub_type, version_sub_type_options %>
  </p>
  <p>
    <label for="version_planned_start_date"><%= l(:field_planned_start_date) %></label>
    <%= f.date_field :planned_start_date %>
  </p>
  <p>
    <label for="version_effective_date"><%= l(:field_effective_date) %></label>
    <%= f.date_field :effective_date %>
  </p>
  <p>
    <label for="version_status"><%= l(:field_status) %></label>
    <%= f.select :status, Version::VERSION_STATUSES.map { |s| [l("version_status_#{s}"), s] } %>
  </p>
  <p>
    <label for="version_sharing"><%= l(:field_sharing) %></label>
    <%= f.select :sharing, Version::VERSION_SHARINGS.map { |s| [l("label_version_sharing_#{s}"), s] } %>
  </p>
  <p>
    <label for="version_wiki_page_title"><%= l(:label_wiki_page) %></label>
    <%= f.text_field :wiki_page_title, size: 60 %>
  </p>
</div>

<%= javascript_tag do %>
  function toggleSubType() {
    var versionType = document.getElementById('version_version_type').value;
    var subTypeField = document.getElementById('sub_type_field');
    if (versionType === 'Milestone') {
      subTypeField.style.display = '';
    } else {
      subTypeField.style.display = 'none';
      var subTypeSelect = document.getElementById('version_version_sub_type');
      if (subTypeSelect) subTypeSelect.value = '';
    }
  }
<% end %>
